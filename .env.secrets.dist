# Production environment of the Portainer stack (Stacks → charges-website → Environment variables).
# Paste these lines there in Advanced mode; never commit the real values.
#
# Generate each secret with: openssl rand -hex 32
# Never reuse the defaults from api/.env: they are public.

HOST=
APP_SECRET=
JWT_PASSPHRASE=

DATABASE_URL=mysql://charges-user:CHANGE_ME@db:3306/charges-website?serverVersion=11.6.2-MariaDB&charset=utf8mb4
MYSQL_DATABASE=charges-website
MYSQL_USER=charges-user
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

MAILER_DSN=
MAILER_FROM=
FRONTEND_URL=
TZ=Europe/Paris
