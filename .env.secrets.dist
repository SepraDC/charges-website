# Production secrets, sourced by deploy.sh on the server.
# Copy to $REMOTE_DIR/.env.secrets on the server (never commit the real file):
#   cp .env.secrets.dist .env.secrets && chmod 600 .env.secrets
#
# Generate each value with: openssl rand -hex 32
# Never reuse the defaults from api/.env: they are public.

APP_SECRET=
JWT_PASSPHRASE=

# Database credentials: deploy.sh refuses to deploy if they are missing
# from both .env and .env.secrets (it no longer writes any default)
#DATABASE_URL=mysql://charges:CHANGE_ME@db:3306/charges
#MYSQL_PASSWORD=CHANGE_ME
#MYSQL_ROOT_PASSWORD=CHANGE_ME
